<UserControl x:Class="IntunePackageBuilder.App.Views.FormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:IntunePackageBuilder.App.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                <ProgressBar IsIndeterminate="True" Width="160" Height="14" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="BuildProgress" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PhaseText}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ElapsedText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{infra:Loc Common_Back}" Command="{Binding BackCommand}" Margin="0,0,10,0" AutomationProperties.AutomationId="Back" />
                <Button Content="{infra:Loc Form_Create}" Command="{Binding CreateCommand}" IsDefault="True" FontWeight="SemiBold"
                        AutomationProperties.AutomationId="Create" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Heading}" Text="{Binding HeadingText}" AutomationProperties.AutomationId="FormHeading" />
                <StackPanel Margin="0,0,0,8" Visibility="{Binding ShowAdoptedHint, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding AdoptedHintText}" AutomationProperties.AutomationId="AdoptedHint" />
                    <Button HorizontalAlignment="Left" Margin="0,6,0,0" Content="{infra:Loc Form_AdoptedCheck}" Command="{Binding ShowAdvancedCommand}"
                            AutomationProperties.AutomationId="ShowAdvanced" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}" Margin="0" Text="{infra:Loc Form_Source}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding SourceText}" AutomationProperties.AutomationId="SourceText" />

                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Note}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasProblems, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{infra:Loc Form_ProblemsHeading}"
                               AutomationProperties.AutomationId="Problems" />
                    <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ErrorText}" Margin="12,0,0,0" Text="{Binding Message}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsTool, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{infra:Loc Tool_Heading}"
                               AutomationProperties.AutomationId="ToolNeeded" />
                    <TextBlock TextWrapping="Wrap" Text="{infra:Loc Tool_Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{infra:Loc Tool_Choose}" Command="{Binding ChooseToolCommand}" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="ChooseTool" />
                        <Button Content="{infra:Loc Tool_Link}" Command="{Binding OpenToolDownloadCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{infra:Loc Error_Heading}"
                               AutomationProperties.AutomationId="BuildError" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding ErrorText}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Form_MetadataHeading}" />
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{Binding MetadataText, Mode=OneWay}"
                             AutomationProperties.AutomationId="Metadata" AutomationProperties.Name="{infra:Loc Form_MetadataHeading}" />
                    <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Form_SourceCheckHeading}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{infra:Loc Form_SourceCheck}" Command="{Binding CheckSourceCommand}" AutomationProperties.AutomationId="CheckSource" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SourceCheckText}"
                                   AutomationProperties.AutomationId="SourceCheckResult" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding IsEditable}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                                <TextBox Tag="{Binding Key}" AutomationProperties.AutomationId="{Binding Key}"
                                         AutomationProperties.Name="{Binding Label}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                    <Setter Property="AcceptsReturn" Value="True" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="MinHeight" Value="56" />
                                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#B00020" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                                           Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                                <TextBlock Style="{StaticResource Note}" Text="{Binding Hint}"
                                           Visibility="{Binding HasHint, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,16,0,0" DataContext="{Binding Toolkit}"
                            Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Heading}" AutomationProperties.AutomationId="ToolkitHeading" />
                    <CheckBox Content="{infra:Loc Toolkit_Use}" IsChecked="{Binding UseToolkit}" AutomationProperties.AutomationId="UseToolkit" />
                    <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{infra:Loc Toolkit_UseHint}" />

                    <StackPanel Visibility="{Binding UseToolkit, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Zip}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ZipPath}" AutomationProperties.AutomationId="ToolkitZipPath" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ZipStatus}" AutomationProperties.AutomationId="ToolkitZipStatus" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{infra:Loc Toolkit_ZipChoose}" Command="{Binding ChooseZipCommand}" Margin="0,0,10,0"
                                    AutomationProperties.AutomationId="ChooseToolkit" />
                            <Button Content="{infra:Loc Toolkit_ZipDownload}" Command="{Binding OpenDownloadCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{infra:Loc Toolkit_ZipHint}" />

                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_DialogStyle}" />
                        <ComboBox ItemsSource="{Binding DialogStyles}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                  SelectedValue="{Binding DialogStyle}" AutomationProperties.AutomationId="ToolkitDialogStyle"
                                  AutomationProperties.Name="{infra:Loc Toolkit_DialogStyle}" />

                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Accent}" />
                        <TextBox Tag="ToolkitAccent" AutomationProperties.AutomationId="ToolkitAccent" AutomationProperties.Name="{infra:Loc Toolkit_Accent}"
                                 Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{infra:Loc Toolkit_AccentHint}" />

                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Company}" />
                        <TextBox Tag="ToolkitCompany" AutomationProperties.AutomationId="ToolkitCompany" AutomationProperties.Name="{infra:Loc Toolkit_Company}"
                                 Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{infra:Loc Toolkit_CompanyHint}" />

                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Language}" />
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                  SelectedValue="{Binding UiLanguage}" AutomationProperties.AutomationId="ToolkitLanguage"
                                  AutomationProperties.Name="{infra:Loc Toolkit_Language}" />

                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Images}" />
                        <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{infra:Loc Toolkit_ImagesHint}" />
                        <ItemsControl ItemsSource="{Binding Images}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{infra:Loc Toolkit_ImageChoose}" Command="{Binding ChooseCommand}" Margin="0,0,10,0" />
                                            <Button Content="{infra:Loc Toolkit_ImageClear}" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_Behavior}" />
                        <CheckBox Content="{infra:Loc Toolkit_Balloon}" IsChecked="{Binding BalloonNotifications}" />
                        <CheckBox Content="{infra:Loc Toolkit_Progress}" IsChecked="{Binding ShowProgress}" />
                        <CheckBox Content="{infra:Loc Toolkit_Defer}" IsChecked="{Binding AllowDefer}" />
                        <StackPanel Visibility="{Binding AllowDefer, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_DeferTimes}" />
                            <TextBox Tag="ToolkitDeferTimes" AutomationProperties.AutomationId="ToolkitDeferTimes" AutomationProperties.Name="{infra:Loc Toolkit_DeferTimes}"
                                     Text="{Binding DeferTimes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="{infra:Loc Toolkit_DiskSpace}" IsChecked="{Binding CheckDiskSpace}" />
                        <StackPanel Visibility="{Binding CheckDiskSpace, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Toolkit_DiskSpaceMb}" />
                            <TextBox Tag="ToolkitDiskSpace" AutomationProperties.AutomationId="ToolkitDiskSpace" AutomationProperties.Name="{infra:Loc Toolkit_DiskSpaceMb}"
                                     Text="{Binding DiskSpaceMb, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{infra:Loc Toolkit_DiskSpaceHint}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
