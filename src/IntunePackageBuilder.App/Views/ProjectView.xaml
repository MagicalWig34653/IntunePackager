<UserControl x:Class="IntunePackageBuilder.App.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:IntunePackageBuilder.App.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{infra:Loc Common_Back}" Command="{Binding BackCommand}" AutomationProperties.AutomationId="Back" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Heading}" Text="{Binding DisplayName}" AutomationProperties.AutomationId="ProjectName" />
                <TextBlock Style="{StaticResource Label}" Margin="0" Text="{infra:Loc Project_Id}" />
                <TextBlock Text="{Binding ProjectId}" AutomationProperties.AutomationId="ProjectIdText" />

                <TextBlock Style="{StaticResource ErrorText}" Margin="0,10,0,0" Text="{Binding ErrorText}"
                           Visibility="{Binding HasError, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="ProjectError" />

                <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Project_Versions}" />
                <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxHeight="220"
                         AutomationProperties.AutomationId="VersionList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding BuildText}" />
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding InstallerText}" />
                                <TextBlock Text="{Binding VersionText}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Note}" Text="{infra:Loc Project_NoVersions}"
                           Visibility="{Binding HasVersions, Converter={StaticResource VisibleWhenFalse}}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Margin="0,0,8,6" Content="{infra:Loc Project_Update}" Command="{Binding UpdateCommand}" FontWeight="SemiBold"
                            AutomationProperties.AutomationId="Update" />
                    <Button Margin="0,0,8,6" Content="{infra:Loc Project_LoadVersion}" Command="{Binding LoadVersionCommand}"
                            AutomationProperties.AutomationId="LoadVersion" />
                    <Button Margin="0,0,8,6" Content="{infra:Loc Project_NewVersion}" Command="{Binding NewVersionCommand}"
                            AutomationProperties.AutomationId="NewVersion" />
                    <Button Margin="0,0,8,6" Content="{infra:Loc Project_UpdateFolder}" Command="{Binding UpdateFolderCommand}"
                            Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="UpdateFolder" />
                    <Button Margin="0,0,8,6" Content="{infra:Loc Project_NewVersionFolder}" Command="{Binding NewVersionFolderCommand}"
                            Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="NewVersionFolder" />
                </WrapPanel>

                <TextBlock Style="{StaticResource Label}" Text="{infra:Loc Project_Notes}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                         VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditNotes}"
                         AutomationProperties.AutomationId="ProjectNotes" AutomationProperties.Name="{infra:Loc Project_Notes}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{infra:Loc Project_SaveNotes}" Command="{Binding SaveNotesCommand}" AutomationProperties.AutomationId="SaveNotes" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding InfoText}"
                               Visibility="{Binding HasInfo, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="NotesInfo" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
