@{
    # Texts the wrapper shows to the logged-on user. English is the neutral language; Messages.de.psd1 has the same keys.
    CloseTitleInstall   = 'Installation of {0}'
    CloseTitleUninstall = 'Removal of {0}'
    CloseTextInstall    = '{0} is being installed or updated. Please save your work and close the following programs. The installation continues automatically once they are closed.{2}{2}{1}'
    CloseTextUninstall  = '{0} is being removed. Please save your work and close the following programs. The removal continues automatically once they are closed.{2}{2}{1}'
}
